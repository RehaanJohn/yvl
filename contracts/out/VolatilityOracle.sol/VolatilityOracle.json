ddress\"}],\"name\":\"getVariance\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"asset\",\"type\":\"address\"}],\"name\":\"lastUpdated\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"owner\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"asset\",\"type\":\"address\"}],\"name\":\"poke\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"asset\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"feed\",\"type\":\"address\"}],\"name\":\"registerFeed\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"asset\",\"type\":\"address\"},{\"internalType\":\"uint256[]\",\"name\":\"prices\",\"type\":\"uint256[]\"},{\"internalType\":\"uint256[]\",\"name\":\"dts\",\"type\":\"uint256[]\"}],\"name\":\"seedHistory\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"name\":\"volState\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"lastPrice\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"variance\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"lastUpdated\",\"type\":\"uint256\"},{\"internalType\":\"bool\",\"name\":\"initialized\",\"type\":\"bool\"},{\"internalType\":\"uint256\",\"name\":\"lastFeedTime\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{\"seedHistory(address,uint256[],uint256[])\":{\"params\":{\"asset\":\"Collateral asset (feed must be registered)\",\"dts\":\"dts[i] = seconds between prices[i-1] and prices[i] (dts[0] ignored)\",\"prices\":\"Historical prices, WAD-scaled, oldest first\"}}},\"stateVariables\":{\"LAMBDA\":{\"details\":\"\\u03bb = 0.94 \\u2014 J.P. Morgan RiskMetrics standard. Weights the most recent squared return      at (1-\\u03bb)=6% and decays older observations geometrically. Half-life \\u2248 11.2 trading days.\"},\"VAR_PREC\":{\"details\":\"Variance is stored as a PER-SECOND variance (squared return \\u00f7 seconds elapsed between      two feed observations), scaled by an extra VAR_PREC for precision. This makes the      annualised figure independent of how often anyone calls poke().\"}},\"title\":\"VolatilityOracle\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"annualizedVolBps(address)\":{\"notice\":\"Annualised volatility in plain basis points (3,000 = 30%).         \\u03c3_annual\\u00b2 = \\u03c3_per_second\\u00b2 \\u00d7 seconds_per_year, so the result does not depend on         how frequently the oracle is poked.         Returns 0 if the oracle is uninitialised or variance is still zero.\"},\"feeds(address)\":{\"notice\":\"Chainlink price feed per collateral asset address\"},\"getVariance(address)\":{\"notice\":\"Raw EWMA variance, WAD-scaled (for advanced callers).\"},\"lastUpdated(address)\":{\"notice\":\"Timestamp of the last poke for staleness checks.\"},\"owner()\":{\"notice\":\"Owner \\u2014 can register feeds; transfers are intentionally omitted for hackathon scope\"},\"poke(address)\":{\"notice\":\"Read the Chainlink feed and update the EWMA variance for `asset`.         Permissionless \\u2014 callable by keepers, borrowers, or anyone.         First call initialises lastPrice; later calls consume a new observation only         when the feed itself has published a newer round (updatedAt advanced).\"},\"registerFeed(address,address)\":{\"notice\":\"Register a Chainlink price feed for a collateral asset.         Called once per asset during deployment.\"},\"seedHistory(address,uint256[],uint256[])\":{\"notice\":\"Warm-start the EWMA from real historical prices so volatility is meaningful         from day one (instead of 0% until weeks of pokes accumulate).\"},\"volState(address)\":{\"notice\":\"EWMA state per collateral asset\"}},\"notice\":\"EWMA (Exponentially Weighted Moving Average) volatility oracle for tokenised equity assets.         Uses the RiskMetrics-standard decay factor \\u03bb=0.94. O(1) state per asset, O(1) update cost.         Designed for AAPL-token and PLTR-token on Arbitrum Sepolia (hackathon scope).\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/VolatilityOracle.sol\":\"VolatilityOracle\"},\"evmVersion\":\"osaka\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@chainlink/contracts/=lib/chainlink-brownie-contracts/contracts/\",\":chainlink-brownie-contracts/=lib/chainlink-brownie-contracts/\",\":forge-std/=lib/forge-std/src/\"]},\"sources\":{\"lib/chainlink-brownie-contracts/contracts/src/v0.8/shared/interfaces/AggregatorV3Interface.sol\":{\"keccak256\":\"0x257a8d28fa83d3d942547c8e129ef465e4b5f3f31171e7be4739a4c98da6b4f0\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://6d39e11b1dc7b9b8ccdabbc9be442ab7cda4a81c748f57e316dcb1bcb4a28bf9\",\"dweb:/ipfs/QmaG6vz6W6iEUBsbHSBob5mdcitYxWjoygxREHpsJHfWrS\"]},\"src/VolatilityOracle.sol\":{\"keccak256\":\"0x67d38adb1f5c4e32389a992bdad4f21a760aaf6f76b571802d332e6d65a6f28b\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://2220d1f7639a548e752402fdcbf8e1291cce77f4db919db2137bd3cfef0efb69\",\"dweb:/ipfs/QmWQS5FjCBmbWayLVPCtEzAgVHdRwrx5wCUgXjfseSuYqM\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.37+commit.f401782d"},"language":"Solidity","output":{"abi":[{"inputs":[],"stateMutability":"nonpayable","type":"constructor"},{"inputs":[],"type":"error","name":"BadPrice"},{"inputs":[{"internalType":"address","name":"asset","type":"address"}],"type":"e